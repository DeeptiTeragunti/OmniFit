# Copy to .env (git-ignored) and fill in real values. Never commit actual secrets.

# --- aiservice: Gemini API ---
# Model availability shifts over time - if you get a 404 "model no longer available",
# call https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY to see what
# your key can currently access, and swap the model segment below accordingly.
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=
GEMINI_API_KEY=your-gemini-api-key-here

# --- userservice: Postgres (defaults below match docker-compose.yml) ---
DB_USERNAME=fitness
DB_PASSWORD=fitness

# --- activityservice / aiservice: RabbitMQ (defaults below match docker-compose.yml) ---
RABBITMQ_USERNAME=fitness
RABBITMQ_PASSWORD=fitness

# --- gateway <-> userservice/activityservice/aiservice: internal trust boundary ---
# The gateway stamps this on every request it proxies; each service rejects anything
# missing it, so a request that bypasses the gateway (and its JWT check) gets refused.
# Change this for any real deployment - the checked-in default is dev-only.
INTERNAL_API_SECRET=local-dev-internal-secret-change-me

# --- frontend: which origin the gateway's CORS policy allows ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
